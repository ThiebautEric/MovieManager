# En-têtes Cloudflare Pages (copiés tels quels dans build/web au build Flutter).
# Objectif : mettre en cache long les assets immuables, tout en revalidant les
# points d'entrée pour que chaque déploiement soit pris en compte immédiatement.

# Points d'entrée : jamais mis en cache dur (sinon un déploiement n'est pas vu).
/index.html
  Cache-Control: no-cache, must-revalidate
/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate
/flutter_service_worker.js
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-cache, must-revalidate
/manifest.json
  Cache-Control: no-cache, must-revalidate

# CanvasKit et assets sont versionnés/immuables : cache 1 an.
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
